#!/usr/bin/env python3
"""Turn the latest piano session from the Piano Log into a .mid file.

  piano-session-midi                 # latest session → ~/Documents/Piano Log/MIDI/
  piano-session-midi --gap 10        # a silence this long (minutes) ends a session
  piano-session-midi --reveal        # also select the new file in Finder

The Piano HUD (modules/piano_hud.lua) appends every note on/off and sustain pedal
event to ~/Documents/Piano Log/YYYY-MM-DD.jsonl. A session is the run of events
back from the newest one until a silence longer than --gap (today's and
yesterday's files are read, so a session that crosses midnight stays whole).
The file is written at 120 BPM, so dragging it into a 120 BPM Live set keeps the
timing exactly as played. Prints the path of the new file.
"""
import argparse
import datetime
import json
import os
import struct
import subprocess
import sys

LOG_DIR = os.path.expanduser("~/Documents/Piano Log")
OUT_DIR = os.path.join(LOG_DIR, "MIDI")
PPQ = 480
BPM = 120
TICKS_PER_MS = PPQ * BPM / 60000   # 0.96


def read_events(days=2):
    today = datetime.date.today()
    events = []
    for back in range(days - 1, -1, -1):
        path = os.path.join(LOG_DIR, (today - datetime.timedelta(days=back)).isoformat() + ".jsonl")
        if not os.path.exists(path):
            continue
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    events.append(json.loads(line))
                except ValueError:
                    pass   # a line cut short by a crash; skip it
    events.sort(key=lambda e: e.get("t", 0))
    return events


def latest_session(events, gap_ms):
    if not events:
        return []
    start = len(events) - 1
    while start > 0 and events[start]["t"] - events[start - 1]["t"] <= gap_ms:
        start -= 1
    return events[start:]


def vlq(n):
    out = [n & 0x7F]
    n >>= 7
    while n:
        out.insert(0, (n & 0x7F) | 0x80)
        n >>= 7
    return bytes(out)


def to_midi(session):
    t0 = session[0]["t"]
    raw = []   # (ms, order, bytes); note-offs sort before note-ons at the same time
    held = {}  # (ch, note) -> count of open note-ons
    for e in session:
        ms, ch = e["t"] - t0, int(e.get("ch", 0)) & 0x0F
        if e["type"] == "on":
            key = (ch, e["note"])
            held[key] = held.get(key, 0) + 1
            raw.append((ms, 1, bytes([0x90 | ch, e["note"], max(1, min(127, e["vel"]))])))
        elif e["type"] == "off":
            key = (ch, e["note"])
            if held.get(key):   # an off whose on came before the session started is dropped
                held[key] -= 1
                raw.append((ms, 0, bytes([0x80 | ch, e["note"], 64])))
        elif e["type"] == "sustain":
            raw.append((ms, 0, bytes([0xB0 | ch, 64, max(0, min(127, e["value"]))])))
    end = session[-1]["t"] - t0
    for (ch, note), n in held.items():   # notes still down when the log ends
        for _ in range(n):
            raw.append((end, 0, bytes([0x80 | ch, note, 64])))
    raw.sort(key=lambda r: (r[0], r[1]))

    track = bytearray()
    track += vlq(0) + b"\xFF\x51\x03" + struct.pack(">I", 60_000_000 // BPM)[1:]
    track += vlq(0) + b"\xFF\x58\x04\x04\x02\x18\x08"   # 4/4
    track += vlq(0) + b"\xFF\x03" + vlq(5) + b"Piano"
    last = 0
    for ms, _, msg in raw:
        tick = round(ms * TICKS_PER_MS)
        track += vlq(tick - last) + msg
        last = tick
    track += vlq(0) + b"\xFF\x2F\x00"
    header = b"MThd" + struct.pack(">IHHH", 6, 0, 1, PPQ)
    return header + b"MTrk" + struct.pack(">I", len(track)) + bytes(track)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--gap", type=float, default=10, help="minutes of silence that end a session (default 10)")
    ap.add_argument("--reveal", action="store_true", help="select the new file in Finder")
    args = ap.parse_args()

    session = latest_session(read_events(), args.gap * 60_000)
    notes = sum(1 for e in session if e["type"] == "on")
    if not notes:
        print("No notes in the Piano Log yet.", file=sys.stderr)
        return 1
    os.makedirs(OUT_DIR, exist_ok=True)
    start = datetime.datetime.fromtimestamp(session[0]["t"] / 1000)
    path = os.path.join(OUT_DIR, start.strftime("%Y-%m-%d %H.%M") + " piano.mid")
    with open(path, "wb") as f:
        f.write(to_midi(session))
    mins = (session[-1]["t"] - session[0]["t"]) / 60000
    print(json.dumps({"path": path, "notes": notes, "minutes": round(mins, 1)}))
    if args.reveal:
        subprocess.run(["open", "-R", path])
    return 0


if __name__ == "__main__":
    sys.exit(main())
